__pycache__/
*.pyc
*.pyo

# 编辑器
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# 本地数据源构建脚本（依赖本地环境，不上传）
tools/build_index_private.py

